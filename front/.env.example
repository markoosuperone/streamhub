# Copy to .env and adjust. Placeholders only — this is the one env file that
# IS committed.

# Origin of the Fastify backend that the /api/:path* rewrite in next.config.ts
# forwards to. Deliberately NOT prefixed with NEXT_PUBLIC_: that would inline
# the backend's address into the browser bundle, and nothing in the browser
# needs it — the client only ever calls same-origin /api/* paths.
#
# Optional; next.config.ts falls back to http://localhost:8000.
API_URL=http://localhost:8000
