# Copy to .env and fill in. Every value here is a placeholder — never paste a
# real secret into this file, it is the one env file that IS committed.
#
# Variables without a default are required: the process refuses to start
# without them (env-schema validates against src/config/env.ts).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=superplayer
# Used by the postgres.js client and the migration runner. Must point at the
# same database as the values above.
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/superplayer

# ── Server ────────────────────────────────────────────────────────────────────
HOST=localhost
PORT=8000
# One of: debug | info | warn | error
LOG_LEVEL=info

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate your own, e.g. `openssl rand -hex 32`, and keep the two different.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
# Lifetimes in seconds: 1 hour and 24 hours.
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=86400

# ── Cookies ───────────────────────────────────────────────────────────────────
# Marks the auth and CSRF cookies Secure. Leave false for local plain HTTP;
# it MUST be true in production or the session cookies travel in clear text.
COOKIE_SECURE=false

# ── Media ─────────────────────────────────────────────────────────────────────
# Maximum accepted upload size, in bytes. 524288000 = 500 MB.
MAX_FILE_SIZE_BYTES=524288000
